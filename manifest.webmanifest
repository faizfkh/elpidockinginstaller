{
  "name": "ELPI Docking Monitor",
  "short_name": "ELPI Docking",
  "description": "ELPI Docking Specialist Monitoring: jadwal survey, docking plan, biaya, dan monitoring pasca-docking armada.",
  "lang": "id",
  "id": "/elpidockinginstaller/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F1F3F2",
  "theme_color": "#1D5650",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://faizfkh.github.io/elpidockinginstaller/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false
}
